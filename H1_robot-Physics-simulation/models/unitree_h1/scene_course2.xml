<mujoco model="h1 warehouse course">
  <!--
    M0NARCH test environment 2: "warehouse". Put this file next to h1.xml
    (H1_robot-Physics-simulation/models/unitree_h1/). Floor top is z = 0 everywhere.
    The robot starts at (0, 0) facing +x. The goal is the site "nav_goal".
    Hazards, in order: low pallet (0.15 m), columns, a trench with a 2.3 m bridge
    along the north wall, an overhead beam (bottom 1.1 m: the robot is 1.7 m tall,
    so it must go around), and a 1.2 m doorway between shelves.
  -->
  <include file="h1.xml"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="160" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <material name="wall" rgba="0.55 0.6 0.65 1"/>
    <material name="pallet" rgba="0.75 0.55 0.3 1"/>
    <material name="column" rgba="0.85 0.85 0.8 1"/>
    <material name="hazard" rgba="0.9 0.2 0.15 1"/>
    <material name="beam" rgba="0.95 0.7 0.1 1"/>
    <material name="shelf" rgba="0.3 0.45 0.7 1"/>
    <material name="goal" rgba="0.2 0.9 0.3 0.6"/>
  </asset>

  <worldbody>
    <light pos="6 0 5" dir="0 0 -1" directional="true"/>

    <!-- floor (boxes, so the trench can be a real hole) -->
    <geom name="floor_west"   type="box" size="3.3 5 0.05"   pos="1.3 0 -0.05"  material="groundplane"/>
    <geom name="floor_east"   type="box" size="4.2 5 0.05"   pos="9.8 0 -0.05"  material="groundplane"/>
    <geom name="floor_bridge" type="box" size="0.5 1.2 0.05" pos="5.1 3.8 -0.05" material="groundplane"/>
    <geom name="trench_bottom" type="box" size="0.5 3.8 0.02" pos="5.1 -1.2 -0.6" material="hazard"/>

    <!-- perimeter walls, 1 m high -->
    <geom name="wall_north" type="box" size="8 0.1 0.5" pos="6 5.0 0.5"  material="wall"/>
    <geom name="wall_south" type="box" size="8 0.1 0.5" pos="6 -5.0 0.5" material="wall"/>
    <geom name="wall_west"  type="box" size="0.1 5 0.5" pos="-2 0 0.5"   material="wall"/>
    <geom name="wall_east"  type="box" size="0.1 5 0.5" pos="14 0 0.5"   material="wall"/>

    <!-- zone A: low pallet + columns -->
    <geom name="pallet"   type="box" size="0.3 0.6 0.075" pos="2.4 0.2 0.075" material="pallet"/>
    <geom name="column_1" type="cylinder" size="0.25 1.25" pos="3.4 -2.4 1.25" material="column"/>
    <geom name="column_2" type="cylinder" size="0.25 1.25" pos="3.0 2.6 1.25"  material="column"/>

    <!-- zone C: overhead beam (bottom at 1.1 m) with a gap on the south side -->
    <geom name="beam" type="box" size="0.15 3.0 0.15" pos="7.5 2.0 1.25" material="beam"/>
    <geom name="column_3" type="cylinder" size="0.25 1.25" pos="8.6 -3.2 1.25" material="column"/>

    <!-- zone D: shelves with a 1.2 m doorway -->
    <geom name="shelf_south" type="box" size="0.2 2.2 1.0" pos="10.2 -2.8 1.0" material="shelf"/>
    <geom name="shelf_north" type="box" size="0.2 2.2 1.0" pos="10.2 2.8 1.0"  material="shelf"/>

    <!-- goal marker (visual only) -->
    <site name="nav_goal" pos="12.5 0 0.01" size="0.3 0.01" type="cylinder" material="goal"/>
  </worldbody>

  <keyframe>
    <key name="home" qpos="0 0 0.98 1 0 0 0 0 0 -0.4 0.8 -0.4 0 0 -0.4 0.8 -0.4 0 0 0 0 0 0 0 0 0"/>
  </keyframe>
</mujoco>
