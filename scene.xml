<mujoco model="spaceborn_h1_task">
  <compiler angle="radian" coordinate="local"/>
  <option gravity="0 0 -9.81" timestep="0.005"/>

  <visual>
    <global offwidth="1280" offheight="720"/>
    <quality shadowsize="2048"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.05 0.05 0.08" rgb2="0.01 0.01 0.02" width="512" height="512"/>
    <texture name="grid" type="2d" builtin="checker" rgb1="0.12 0.12 0.14" rgb2="0.08 0.08 0.10" width="512" height="512"/>
    <material name="grid_mat" texture="grid" texrepeat="20 20" reflectance="0.05"/>
    <material name="robot_mat" rgba="0.2 0.22 0.25 1.0" specular="0.4" shininess="0.5"/>
    <material name="accent_mat" rgba="0.9 0.9 0.9 1.0" specular="0.8" shininess="0.9"/>
    <material name="object_mat" rgba="0.95 0.45 0.1 1.0" specular="0.6"/>
    <material name="target_mat" rgba="0.1 0.8 1.0 0.4"/>
  </asset>

  <worldbody>
    <light diffuse="0.8 0.8 0.8" pos="0 -2 4" dir="0 0.5 -1"/>
    <light diffuse="0.4 0.4 0.5" pos="2 2 3" dir="-0.5 -0.5 -1"/>
    <geom name="floor" type="plane" size="10 10 0.1" material="grid_mat"/>

    <!-- Work Table -->
    <body name="table" pos="0.6 0 0.4">
      <geom type="box" size="0.35 0.6 0.4" rgba="0.15 0.15 0.18 1.0"/>
    </body>

    <!-- Pickable Object -->
    <body name="payload" pos="0.55 0.15 0.85">
      <freejoint name="payload_joint"/>
      <geom name="payload_geom" type="box" size="0.04 0.04 0.04" material="object_mat" mass="0.2"/>
    </body>

    <!-- Interactive Click Target Indicator -->
    <body name="target_marker" pos="0.55 -0.2 0.82" mocap="true">
      <geom type="cylinder" size="0.06 0.005" material="target_mat" contype="0" conaffinity="0"/>
    </body>

    <!-- Humanoid Upper Body / Manipulator -->
    <body name="base" pos="0 0 0.8">
      <geom name="torso" type="cylinder" size="0.12 0.25" material="robot_mat"/>
      <joint name="torso_yaw" type="hinge" axis="0 0 1" range="-1.57 1.57"/>

      <!-- Right Arm -->
      <body name="r_shoulder" pos="0.18 -0.22 0.18">
        <geom type="sphere" size="0.05" material="accent_mat"/>
        <joint name="r_shoulder_pitch" type="hinge" axis="0 1 0" range="-2.8 1.5"/>
        <joint name="r_shoulder_roll" type="hinge" axis="1 0 0" range="-1.5 1.5"/>

        <body name="r_upper_arm" pos="0 0 -0.2">
          <geom type="capsule" fromto="0 0 0.2 0 0 0" size="0.04" material="robot_mat"/>
          <joint name="r_elbow" type="hinge" axis="0 1 0" range="0 2.2"/>

          <body name="r_hand" pos="0 0 -0.18">
            <geom name="gripper" type="box" size="0.03 0.03 0.05" material="accent_mat"/>
            <site name="r_ee" pos="0 0 -0.06" size="0.01"/>
          </body>
        </body>
      </body>

      <!-- Base Legs (Kinematic Representation) -->
      <body name="legs" pos="0 0 -0.4">
        <geom type="cylinder" size="0.08 0.2" material="robot_mat"/>
      </body>
    </body>
  </worldbody>

  <actuator>
    <position name="act_torso_yaw" joint="torso_yaw" kp="200" ctrlrange="-1.57 1.57"/>
    <position name="act_r_shoulder_pitch" joint="r_shoulder_pitch" kp="150" ctrlrange="-2.8 1.5"/>
    <position name="act_r_shoulder_roll" joint="r_shoulder_roll" kp="150" ctrlrange="-1.5 1.5"/>
    <position name="act_r_elbow" joint="r_elbow" kp="120" ctrlrange="0 2.2"/>
  </actuator>
</mujoco>
